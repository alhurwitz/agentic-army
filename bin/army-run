#!/bin/sh
# Runs a TypeScript entry point with Bun, or with the Bun runtime bundled inside OpenCode
# when Bun is not installed.
if command -v bun >/dev/null 2>&1; then exec bun "$@"; fi
if command -v opencode >/dev/null 2>&1; then BUN_BE_BUN=1 exec opencode "$@"; fi
echo "agentic-army: needs bun or opencode on PATH" >&2
exit 127
